name: Watchdog Verificador Inteligente

on:
  schedule:
    - cron: '0 13 * * 1'
  workflow_dispatch:

jobs:
  watchdog:
    runs-on: ubuntu-latest

    steps:
      - name: Verificar workflow principal y reactivar si es necesario
        env:
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
        run: |
          echo "Verificando workflow principal..."
          curl -L \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/${{ github.repository }}/actions/workflows/alerta_examenes.yml/dispatches \
            -d '{"ref":"main"}'
          echo "Workflow principal relanzado por watchdog."
